{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSeatCountsForEventList",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/EventSeats"
    },
    {
      "Sid": "ReadOwnRegistrations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Registrations"
    },
    {
      "Sid": "WebAppSendsRegistrationIntents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_ID>:eventhub-registrations"
    },
    {
      "Sid": "WorkerConsumesRegistrationQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_ID>:eventhub-registrations"
    },
    {
      "Sid": "WorkerStartsRegistrationWorkflow",
      "Effect": "Allow",
      "Action": "states:StartExecution",
      "Resource": "arn:aws:states:ap-south-1:<ACCOUNT_ID>:stateMachine:eventhub-register"
    },
    {
      "Sid": "ReadConfigurationParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:<ACCOUNT_ID>:parameter/eventhub/*"
    },
    {
      "Sid": "DecryptSecureStringsOnlyViaSSM",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-south-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SubscribeStudentsForNotifications",
      "Effect": "Allow",
      "Action": [
        "sns:Subscribe",
        "sns:SetSubscriptionAttributes"
      ],
      "Resource": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:eventhub-notifications"
    }
  ]
}
