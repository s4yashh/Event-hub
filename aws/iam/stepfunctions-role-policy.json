{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReserveSeatWithConditionalUpdate",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/EventSeats"
    },
    {
      "Sid": "WriteRegistrationResult",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Registrations"
    },
    {
      "Sid": "UpdateRegistrationStatus",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Registrations"
    },
    {
      "Sid": "PublishNotification",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:eventhub-notifications"
    }
  ]
}
