[Unit]
Description=EventHub Flask web app (BCSE355L project)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/eventhub
Environment=AWS_DEFAULT_REGION=ap-south-1
# gunicorn binds port 80 without running as root via CAP_NET_BIND_SERVICE
ExecStart=/opt/eventhub/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 app:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
